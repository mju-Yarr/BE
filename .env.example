# 로컬/배포 환경변수 예시. 복사해서 .env로 저장하고 값을 채운다.
#   cp .env.example .env
# docker-compose가 같은 디렉토리의 .env를 자동으로 읽는다 (docker-compose.yml 참고).

### DB — 로컬 개발은 docker-compose의 postgres 서비스 기본값 그대로 쓰면 됨 ###
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend
DB_USER=backend
DB_PASSWORD=backend

### Google OAuth — 구글 로그인(POST /auth/google) + 캘린더 연동(offline 리프레시 토큰 발급용) ###
# Google Cloud Console(console.cloud.google.com) > APIs & Services > Credentials
# > Create Credentials > OAuth client ID > Web application 으로 발급.
# client-secret은 캘린더 refresh_token/authorization_code 교환에 쓰여서 Web application 타입이어야 함.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

### 이메일 인증 — Gmail SMTP는 전용 계정의 앱 비밀번호만 사용한다 ###
# SMTP_ENABLED=true일 때만 실제 인증 메일 발송을 허용한다.
EMAIL_VERIFICATION_ENABLED=true
# 이메일 인증 링크는 발급 시점부터 30분 유효하다.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
# 재발송 쿨다운(초). 60초 이내 재요청은 무시한다.
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM=
# 사용자가 메일에서 여는 공개 API base URL. 로컬 테스트는 http://localhost:8080.
EMAIL_VERIFICATION_BASE_URL=http://localhost:8080

### 약관 정책 버전 — 필수 약관이 개정될 때 올리고 FE와 함께 검증 ###
CONSENT_POLICY_VERSION=v1

### 공공데이터포털 — 기상청 단기예보 (KmaEnvironmentProvider) ###
# data.go.kr 로그인 후 "기상청_단기예보 ((구)_동네예보) 조회서비스" 페이지에서 활용신청.
# 승인 후 마이페이지 > 데이터활용 > Open API 에서 인증키(일반 인증키, Decoding) 복사.
DATA_GO_KR_SERVICE_KEY=

### JWT / 암호화 — 배포 전 반드시 아래 dev 기본값과 다른 값으로 교체 ###
JWT_SECRET=
ENCRYPTION_SECRET=
ENCRYPTION_SALT=

### ODsay — 서버 플랫폼 키 (고정 공인 IPv4 allowlist 등록 후 발급) ###
# 절대 Git에 실제 키를 기록하지 말고, 배포 서버의 .env에만 설정한다.
ODSAY_API_KEY=
# 선택값: 외부 API 연결/응답 제한 시간(ms)
ODSAY_CONNECT_TIMEOUT_MS=2000
ODSAY_READ_TIMEOUT_MS=3000

### OpenAI — 일정 텍스트 분류 등 AI 기능 ###
# platform.openai.com > API keys 에서 발급. 절대 Git에 실제 키를 기록하지 않는다.
OPENAI_API_KEY=
# Responses API base URL과 pinned model은 배포마다 바꾸지 않는다.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini-2024-07-18
# 선택값: API 호출 제한 시간(ms)
OPENAI_CONNECT_TIMEOUT_MS=3000
OPENAI_READ_TIMEOUT_MS=10000
# 기본값은 AI 호출을 하지 않는 fail-closed 상태다. 활성화에는 key·정확한 privacy policy 버전·승인이 모두 필요하다.
OPENAI_CLASSIFICATION_ENABLED=false
OPENAI_CLASSIFICATION_ROLLOUT_PERCENT=0
OPENAI_CLASSIFICATION_MAX_PER_SYNC=5
OPENAI_CLASSIFICATION_MAX_CONCURRENCY=2
OPENAI_AI_PRIVACY_POLICY_VERSION=
# title snapshot은 24시간 이내 폐기하고 review는 90일 뒤 UTC cron으로 삭제한다.
OPENAI_CLASSIFICATION_RETENTION_PURGE_DELAY_MS=300000
OPENAI_CLASSIFICATION_RETENTION_DELETE_CRON=0 30 3 * * *

### 환경 Provider — AirKorea 실시간 측정소 + 기상청 생활기상 UV ###
# KMA 단기예보 key와 AirKorea key는 data.go.kr에서 각각 발급합니다. 실제 key는 절대 Git에 기록하지 않습니다.
AIRKOREA_SERVICE_KEY=
# 예: 종로구. 현재 deployment가 사용하는 실제 측정소 이름으로 설정합니다.
AIRKOREA_STATION_NAME=
# 예: 1100000000. 기상청 생활기상지수 API의 행정구역 코드로, 좌표에서 추론하지 않습니다.
KMA_UV_AREA_NO=
ENVIRONMENT_CONNECT_TIMEOUT_MS=2000
ENVIRONMENT_READ_TIMEOUT_MS=3000

### Plan Engine — AI 계획 엔진 (Python FastAPI) ###
# Docker Compose 내부에서는 plan-engine 서비스명으로 접근. 로컬 개발은 localhost:8000.
PLAN_ENGINE_BASE_URL=http://localhost:8000

### Firebase — FCM 서버 푸시 ###
# 서비스 계정 JSON 파일 경로. 비어있으면 FCM 발송 비활성화(로컬 알림 폴백).
# 절대 Git에 서비스 계정 파일을 기록하지 않는다.
FIREBASE_SERVICE_ACCOUNT_PATH=

### Wellness 일일 집계 스케줄 ###
# Spring cron 표현식. 기본: 매일 00:05 KST (서버 UTC 기준 15:05).
WELLNESS_DAILY_SUMMARY_CRON=0 5 0 * * *
